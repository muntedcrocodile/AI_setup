{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "websearch": "deny",
    "external_directory": {
      "/tmp/**": "allow"
    }
  },
  "mcp": {
    "searxng": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "mcp-searxng"
      ],
      "environment": {
        "SEARXNG_URL": "http://localhost:1080"
      },
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "chrome-devtools-mcp"
      ],
      "enabled": true
    }
  },
  "provider": {
    "openrouter": {
      "models": {
        "minimax/minimax-m2.5": {
          "options": {
            "provider": {
              "order": [
                "inceptron/fp8",
                "akashml/fp8"
              ],
              "allow_fallbacks": true
            }
          }
        }
      },
      "minimax/minimax-m3": {
        "options": {
          "provider": {
            "order": [
              "novita"
            ],
            "allow_fallbacks": true
          }
        }
      }
    }
  }
}