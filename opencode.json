{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "websearch": "deny",
    "external_directory": {
      "/tmp/**": "allow",
      "/home/user/.cargo/**": "allow"
    }
  },
  "mcp": {
    "searxng": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "mcp-searxng"
      ],
      "environment": {
        "SEARXNG_URL": "http://localhost:1080"
      },
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "chrome-devtools-mcp"
      ],
      "enabled": true
    }
  },
  "provider": {
    "openrouter": {
      "models": {
        "minimax/minimax-m2.5": {
          "options": {
            "provider": {
              "order": [
                "inceptron/fp8",
                "akashml/fp8"
              ],
              "allow_fallbacks": true
            }
          }
        },
        "minimax/minimax-m3": {
          "options": {
            "provider": {
              "order": [
                "venice/fp8",
                "together",
                "parasail/fp8"
              ],
              "allow_fallbacks": true
            },
            "reasoning": {
              "effort": "high",
              "exclude": false
            }
          }
        },
        "minimax/minimax-m3:exacto": {
          "options": {
            "provider": {
              "order": [
                "venice/fp8",
                "together",
                "parasail/fp8"
              ],
              "allow_fallbacks": true
            },
            "reasoning": {
              "effort": "high",
              "exclude": false
            }
          }
        }
      }
    }
  },
  "agent": {}
}